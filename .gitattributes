# Normalize line endings. Text is LF in the repo; Git converts on checkout per-OS.
* text=auto eol=lf

# Scripts that MUST stay LF (they run on Linux; CRLF breaks the shebang).
*.sh    text eol=lf
*.rules text eol=lf
*.conf  text eol=lf
*.service text eol=lf
*.timer text eol=lf

# PowerShell is fine either way, but keep it consistent.
*.ps1   text eol=lf

# Docs
*.md    text eol=lf

# Never munge these if ever added.
*.deb   binary
*.png   binary
*.gz    binary
